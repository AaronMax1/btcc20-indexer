BTCC20_CHAIN=mainnet
BTCC20_VIEWER_PORT=8798
BTCC20_RPC_URL=http://host.docker.internal:28476
BTCC20_RPC_USER=btcc_rpc_user
BTCC20_RPC_PASSWORD=change_me
BTCC20_INDEX_INTERVAL_MS=60000
BTCC20_REORG_CHECK_DEPTH=20

# Host path to the compiled btcc20-inscriber ord binary.
BTCC20_ORD_HOST_PATH=../btcc20-inscriber/target/release/ord

