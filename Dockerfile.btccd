FROM debian:bookworm-slim AS builder

ARG BTCCD_REPO=https://github.com/Marcus-Vane/Bitcoin-Classic.git
ARG BTCCD_REF=main

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    automake \
    autotools-dev \
    bsdmainutils \
    build-essential \
    ca-certificates \
    git \
    libboost-chrono-dev \
    libboost-dev \
    libboost-filesystem-dev \
    libboost-system-dev \
    libboost-thread-dev \
    libevent-dev \
    libtool \
    pkg-config \
    python3 \
  && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch "$BTCCD_REF" "$BTCCD_REPO" /src

WORKDIR /src

RUN ./autogen.sh \
  && ./configure \
    --disable-bench \
    --disable-fuzz-binary \
    --disable-tests \
    --disable-wallet \
    --disable-zmq \
    --without-gui \
    --without-miniupnpc \
    --without-natpmp \
  && make -j"$(nproc)" \
  && make install DESTDIR=/out

FROM debian:bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    libboost-chrono1.74.0 \
    libboost-filesystem1.74.0 \
    libboost-system1.74.0 \
    libboost-thread1.74.0 \
    libevent-2.1-7 \
    libevent-pthreads-2.1-7 \
  && rm -rf /var/lib/apt/lists/* \
  && useradd --create-home --home-dir /home/btcc --shell /usr/sbin/nologin btcc \
  && mkdir -p /data \
  && chown -R btcc:btcc /data

COPY --from=builder /out/usr/local/bin/bitcoind /usr/local/bin/bitcoind
COPY --from=builder /out/usr/local/bin/bitcoin-cli /usr/local/bin/bitcoin-cli

USER btcc

EXPOSE 18465 28476

ENTRYPOINT ["bitcoind"]
